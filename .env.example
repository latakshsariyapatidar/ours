# Defaults work for private local HTTP; no passwords need to be supplied.
APP_NAME=Ours
APP_URL=http://localhost:8080
HOST_BIND=127.0.0.1
PORT=8080
# Named volume by default. May instead be an absolute Linux host path such as /srv/ours.
STORAGE_VOLUME=photos
# HTTPS override sets this automatically. Never expose plain HTTP to the public internet.
COOKIE_SECURE=false
DOMAIN=
SESSION_HOURS=168
MAX_UPLOAD_BYTES=52428800
MAX_IMAGE_PIXELS=60000000
MIN_FREE_BYTES=536870912
TRASH_DAYS=30
# Operator-adjustable limit; verify current Instagram policy before changing.
CAROUSEL_LIMIT=20
# Worker and browser upload concurrency are deliberately fixed to one on the 1 GB target.
# Advanced native development only: DATABASE_URL, DB_HOST, DB_NAME, DB_USER,
# DB_PASSWORD, SECRETS_PATH, STORAGE_PATH, NODE_OPTIONS. Docker generates DB credentials.
