{$DOMAIN} {
    root * /srv
    encode gzip
    handle /api/* {
        reverse_proxy api:3000
    }
    handle {
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Cache-Control "no-cache"
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'"
    }
}
